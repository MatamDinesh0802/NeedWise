        },
        "colocatePods": {
          "type": "boolean"
        },
        "size": {
          "type": [
            "string",
            "integer"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "keepOnUninstall": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
