{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkMind Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "credential": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "Stored in the chart's Secret."
        },
        "existingSecret": {
          "type": "string",
          "description": "A Secret you manage."
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "key"
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "description": "A Kubernetes probe; {} disables it."
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "string",
            "integer"
          ]
        },
        "minAvailable": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "pattern": "^$|^https?://"
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "storageClass": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "api": {
          "$ref": "#/definitions/image"
        },
        "web": {
          "$ref": "#/definitions/image"
        }
      },
      "additionalProperties": false,
      "required": [
        "api",
        "web"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^https?://[^/\\s]+/?$",
          "description": "The URL people type into the browser, without a path."
        },
        "appEnv": {
          "enum": [
            "dev",
            "test",
            "demo",
            "production"
          ]
        },
        "logLevel": {
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "logFormat": {
          "enum": [
            "console",
            "json"
          ]
        },
        "assistantMode": {
          "enum": [
            "single",
            "auto",
            "agents"
          ]
        },
        "llm": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "anthropic",
                "openai_compatible"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "$ref": "#/definitions/url"
            },
            "external": {
              "type": "boolean"
            },
            "fallbacks": {
              "type": "boolean"
            },
            "roleModels": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "router": {
                  "type": "string"
                },
                "judge": {
                  "type": "string"
                },
                "generator": {
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "localLlm": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "$ref": "#/definitions/url"
            },
            "model": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "embedding": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "openai_compatible",
                "hash"
              ]
            },
            "baseUrl": {
              "$ref": "#/definitions/url"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "transcription": {
          "type": "object",
          "properties": {
            "provider": {
              "enum": [
                "faster_whisper",
                "openai_compatible",
                "none"
              ]
            },
            "model": {
              "type": "string"
            },
            "baseUrl": {
              "$ref": "#/definitions/url"
            }
          },
          "additionalProperties": false
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "from": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "starttls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "google": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "searxngUrl": {
          "$ref": "#/definitions/url"
        },
        "deploymentId": {
          "type": "string"
        },
        "licenseDevPublicKey": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "description": "Other settings as environment variables.",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "publicUrl",
        "appEnv"
      ]
    },
    "credentials": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "databaseAppPassword": {
          "$ref": "#/definitions/credential"
        },
        "databaseOwnerPassword": {
          "$ref": "#/definitions/credential"
        },
        "postgresPassword": {
