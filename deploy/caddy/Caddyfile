{
	admin off
	auto_https off
}

# Public entry point: one origin serves the UI, the API and the login pages,
# so the session cookie works everywhere without CORS.
# API_UPSTREAM / WEB_UPSTREAM point at containers by default; `make infra` points them at
# processes on your machine (host.docker.internal) for hot-reload development.
:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		?X-Frame-Options SAMEORIGIN
		-Server
	}

	@api path /api/* /mcp /mcp/*
	handle @api {
		# Keycloak calls back-channel logout on the internal network; never expose it.
		@backchannel path /api/auth/backchannel-logout
		respond @backchannel 404
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	@keycloak path /auth /auth/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}

# Container healthcheck only. This port is not published.
:9180 {
	respond "ok" 200
}
