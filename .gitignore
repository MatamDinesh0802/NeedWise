# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node / Next.js (apps/web has its own .gitignore too)
node_modules/
.next/
out/
*.tsbuildinfo

# Local tooling
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.playwright-mcp/
graphify-out/

# The built documentation site (`make docs`)
/site/

# Data produced at runtime
/data/
/.data/

# Development license and signing key (`make ee-dev-license`)
/.workmind/
evals/results/*.tmp

# Evaluation runs: the Markdown reports are committed, the per-item JSON stays local
/evals/results/*.json

# Backups (`make backup`): they hold every tenant's data
/backups/
