# Copy to .env and change what you need. Every value here has a working default in
# compose.yaml, so `make up` works without a .env file. Defaults are for local development
# only: never use them on a server.

# --- Host ports (all bound to 127.0.0.1) -------------------------------------------------
HTTP_PORT=8480          # main entry point: UI + API + login, via Caddy
PUBLIC_URL=http://localhost:8480   # must match HTTP_PORT; used for login redirects
API_PORT=8400           # direct API access (OpenAPI docs at /api/docs)
WEB_PORT=3400           # direct web access
POSTGRES_PORT=5432
VALKEY_PORT=6379
QDRANT_PORT=6333
OPENFGA_PORT=8401

# --- Passwords (dev defaults; change for anything shared) ------------------------------------
POSTGRES_PASSWORD=postgres
WORKMIND_OWNER_PASSWORD=workmind_owner
WORKMIND_APP_PASSWORD=workmind_app
KEYCLOAK_DB_PASSWORD=keycloak
OPENFGA_DB_PASSWORD=openfga
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret   # shared by Keycloak and the API; required in production
DEMO_PASSWORD=workmind-demo                     # password of the demo logins created by `make seed`
OPENFGA_API_KEY=dev-only-openfga-key            # pre-shared key between the API and OpenFGA

# --- Models (ADR 0007) ------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...                # needed for answers with the default provider
# LLM_PROVIDER=anthropic                      # or openai_compatible (Ollama, vLLM, llama.cpp)
# LLM_MODEL=claude-sonnet-5-5                 # default for every role (claude-opus-5-5 for more depth)
# LLM_MODEL_ROUTER=                           # optional per-role overrides: ANSWER, ROUTER, JUDGE, GENERATOR, AGENT
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # openai_compatible only
# EMBEDDING_BASE_URL=http://host.docker.internal:8091/v1   # make embeddings (EmbeddingGemma)
# RETRIEVAL_RRF_K=2                           # hybrid fusion (see evals/README.md for the ablation)
# RETRIEVAL_SPARSE_WEIGHT=0.5
#
# Restricted documents and external models (ARCHITECTURE 11.6). Tenants default to
# restricted_data=local_only: restricted sources go only to this local model, or are left out.
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1   # e.g. Ollama
# LOCAL_LLM_MODEL=qwen3:14b
# LLM_EXTERNAL=false                          # set true if LLM_BASE_URL is a hosted API
#
# Meetings: speech to text. faster_whisper runs on the worker's CPU (about 25x real time with
# base.en: a 23-minute recording in under a minute); larger models (small.en, medium.en) are
# slower and more accurate. Or point at any /v1/audio/transcriptions server.
# TRANSCRIPTION_PROVIDER=faster_whisper       # or openai_compatible, or none (transcripts only)
# TRANSCRIPTION_MODEL=base.en
# TRANSCRIPTION_BASE_URL=http://host.docker.internal:8000/v1   # openai_compatible only
#
# Business intelligence (docs/analytics.md). The BI agent's tool loop uses the AGENT role, its
# narrative the ANSWER role. Query results (up to 50 rows per query) go to that model.
# ANALYTICS_MAX_ROWS=1000                     # row cap per query (at most 10000)
# ANALYTICS_TIMEOUT_S=10                      # per query, in seconds (at most 120)

# --- Connectors and tools ----------------------------------------------------------------------
# SECRETS_KEY=                                # encrypts connector credentials; required in production:
#                                             #   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# GOOGLE_CLIENT_ID=                           # Google Drive sources (docs/connectors.md)
# GOOGLE_CLIENT_SECRET=
# SEARXNG_URL=http://searxng:8080             # optional web_search tool for the research agent
# MCP_SERVERS='[{"key": "erp", "url": "https://erp.example/mcp", "token": "...", "read_only": ["stock"]}]'

# --- API ------------------------------------------------------------------------------------
APP_ENV=dev             # dev | test | demo | production
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # enable tracing to any OTLP backend
