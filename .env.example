# Copy to .env and change what you need. Every value here has a working default in
# compose.yaml, so `make up` works without a .env file. Defaults are for local development
# only: never use them on a server.

# --- Host ports (all bound to 127.0.0.1) -------------------------------------------------
HTTP_PORT=8480          # main entry point: UI + API + login, via Caddy
PUBLIC_URL=http://localhost:8480   # must match HTTP_PORT; used for login redirects
API_PORT=8400           # direct API access (OpenAPI docs at /api/docs)
WEB_PORT=3400           # direct web access
POSTGRES_PORT=5432
VALKEY_PORT=6379
QDRANT_PORT=6333
OPENFGA_PORT=8401

# --- Passwords (dev defaults; change for anything shared) ------------------------------------
POSTGRES_PASSWORD=postgres
WORKMIND_OWNER_PASSWORD=workmind_owner
WORKMIND_APP_PASSWORD=workmind_app
KEYCLOAK_DB_PASSWORD=keycloak
OPENFGA_DB_PASSWORD=openfga
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret   # shared by Keycloak and the API; required in production
DEMO_PASSWORD=workmind-demo                     # password of the demo logins created by `make seed`

# --- API ------------------------------------------------------------------------------------
APP_ENV=dev             # dev | test | demo | production
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # enable tracing to any OTLP backend
